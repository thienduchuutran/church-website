PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# Database - for local dev, run `docker compose up -d` and use the line below.
# For production, this is set in the systemd env file on EC2 to the RDS endpoint.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/church_dev

# Supabase Auth (used for Google login JWT verification - same value local & prod)
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Discord webhooks - leave blank locally so dev posts don't ping the church.
DISCORD_WEBHOOK_EVENTS=
DISCORD_WEBHOOK_ANNOUNCEMENTS=
DISCORD_WEBHOOK_BIBLE_STUDIES=
DISCORD_WEBHOOK_PLAYLISTS=
DISCORD_WEBHOOK_GALLERY=

# Discord per-message identity overrides (optional - defaults applied in code).
DISCORD_WEBHOOK_USERNAME=Duc
DISCORD_WEBHOOK_AVATAR_URL=https://cdn.discordapp.com/avatars/1018271669938307102/2aca3d1181e6643b78d9401b25582e48.webp
