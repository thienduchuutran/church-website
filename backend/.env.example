PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# Database - for local dev, run `docker compose up -d` and use the line below.
# For production, the same key is set in Render's dashboard pointing at the
# Supabase session pooler (postgres.<ref>@aws-1-us-east-1.pooler.supabase.com:5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/church_dev

# Supabase Auth (used for Google login JWT verification - same value local & prod)
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Object storage - optional locally (only needed if you want to test image/video
# upload paths). Leave blank to disable storage-backed features for dev.
# In production, these are set in Render's dashboard and point at Cloudflare R2.
S3_BUCKET=
S3_REGION=auto
AWS_REGION=auto
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public base URL for gallery images. Set to the r2.dev URL Cloudflare generates
# when you enable public access on the bucket (https://pub-<hash>.r2.dev), or to
# your custom domain when you bind one (https://media.example.com). Gallery
# images skip presigning and use this base directly so the frontend gets stable,
# CDN-cacheable URLs. Leave blank locally - the post service will fall back to
# presigned URLs for gallery images too.
R2_PUBLIC_URL=

# Discord webhooks - leave blank locally so dev posts don't ping the church.
DISCORD_WEBHOOK_EVENTS=
DISCORD_WEBHOOK_ANNOUNCEMENTS=
DISCORD_WEBHOOK_BIBLE_STUDIES=
DISCORD_WEBHOOK_PLAYLISTS=
DISCORD_WEBHOOK_GALLERY=

DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=
DISCORD_OAUTH_STATE_SECRET